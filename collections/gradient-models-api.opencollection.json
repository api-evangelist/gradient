{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gradient Cloud AI Chat Models API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apis.gradient.network/api/v1/ai/models"
          },
          "docs": "List of all available AI models. No authentication required."
        }
      ]
    }
  ],
  "bundled": true
}